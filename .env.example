# Air Quality Forecasting & Alert System - Environment Variables
# Author: Khushi Yadav (@khushiyadav35)

# Telegram Bot Alert Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_or_channel_here"

# SMTP Email Alert Configuration
ALERT_SENDER_EMAIL="your_email@gmail.com"
ALERT_EMAIL_PASSWORD="your_app_specific_password_here"
ALERT_RECIPIENT_EMAILS="recipient1@gmail.com,recipient2@gmail.com"

# API Keys (Optional - Open-Meteo works without keys; OpenAQ optional)
OPENAQ_API_KEY=""

# Alert Configuration Defaults
ALERT_AQI_THRESHOLD=201
ALERT_COOLDOWN_HOURS=4
